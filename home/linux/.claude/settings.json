{
  "env": {
    "CLAUDE_CODE_TMUX_TRUECOLOR": "1",
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "3"
  },
  "permissions": {
    "deny": [
      "Artifact",
      "AskUserQuestion",
      "DesignSync",
      "EndConversation",
      "EnterPlanMode",
      "EnterWorktree",
      "ExitPlanMode",
      "ExitWorktree",
      "PushNotification",
      "Workflow"
    ]
  },
  "model": "opus",
  "disableClaudeAiConnectors": true,
  "disableBundledSkills": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hooks/nudge-delegate.py\""
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hooks/explore-scratch-write-guard.py\""
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hooks/subagent-file-handoff.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hooks/same-file-write-audit.py\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hooks/skill-nudge.py\""
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"/home/freman/.claude/plugins/cache/yet-another-statusline/yas/0.7.1/.python/cpython-3.13-linux-x86_64-gnu/bin/python3.13\" \"/home/freman/.claude/plugins/cache/yet-another-statusline/yas/0.7.1/hooks/yas-prompt-hook.py\""
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hooks/handoff-nudge.py\""
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/notify-send 'Claude Code' 'Claude Code finished!' || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/notify-send 'Claude Code' 'Claude Code stopped!' || true"
          }
        ]
      }
    ]
  },
  "disableRemoteControl": true,
  "disableWorkflows": true,
  "disableArtifact": true,
  "statusLine": {
    "type": "command",
    "command": "\"/home/freman/.claude/plugins/cache/yet-another-statusline/yas/0.7.1/.python/cpython-3.13-linux-x86_64-gnu/bin/python3.13\" \"/home/freman/dev/yet-another-statusline/claude/statusline_command.py\"",
    "padding": 1,
    "refreshInterval": 1
  },
  "enabledPlugins": {
    "skill-creator@claude-plugins-official": false,
    "frontend-design@claude-plugins-official": false,
    "superpowers@claude-plugins-official": false,
    "feature-dev@claude-plugins-official": false,
    "claude-code-setup@claude-plugins-official": false,
    "playground@claude-plugins-official": false,
    "hookify@claude-plugins-official": false,
    "huggingface-skills@claude-plugins-official": false,
    "linear@claude-plugins-official": false,
    "chrome-devtools-mcp@claude-plugins-official": false,
    "mintlify@claude-plugins-official": false,
    "playwright@claude-plugins-official": false,
    "exa@claude-plugins-official": false,
    "code-simplifier@claude-plugins-official": false,
    "pyright-lsp@claude-plugins-official": false,
    "plugin-dev@claude-plugins-official": false,
    "yas@yet-another-statusline": false
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    }
  },
  "effortLevel": "low",
  "tui": "fullscreen",
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "remoteControlAtStartup": false
}
